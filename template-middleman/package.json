{
	"devDependencies": {
		"@lopatnov/rollup-plugin-uglify": "^5.0.0",
		"rollup": "^3.9.1",
		"rollup-plugin-sass": "^1.12.17",
		"sass": "^1.103.1"
	},
	"scripts": {
		"css:build": "npx sass --load-path=node_modules/ assets/css/:.build/css/mansite/",
		"css:watch": "npx sass --watch --load-path=node_modules/ assets/css/:.build/css/mansite/",
		"js:build": "npx rollup --config rollup.config.js",
		"js:watch": "npx rollup --config rollup.config.js --watch"
	},
	"type": "module"
}
